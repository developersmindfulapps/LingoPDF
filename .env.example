# LingoPDF Environment Variables Configuration
# Copy this file to .env.local for local development. Never commit .env.local to version control.

# Application Configuration
# Must be set to the exact canonical origin in production (e.g. https://lingopdf.in) for CSRF Origin validation.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Chrome Web Store Configuration
# Centralized destination for "Get the Extension" CTAs. When empty/omitted, buttons show "Coming Soon".
# NEXT_PUBLIC_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/lingopdf-pdf-reader/<id>

# Database Configuration (MongoDB Atlas)
# Replace with your connection string from MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=lingo_pdf

# Rate Limiting & Proxy Trust Configuration (Stage 3B.2 / 3B.3)
# MANDATORY IN PRODUCTION: Dedicated high-entropy secret (>= 32 characters) used to compute
# HMAC-SHA256 digests for IP and email rate-limit bucket identifiers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse MONGODB_URI or other credentials. Rotating this secret resets active 15-minute rate-limit windows.
RATE_LIMIT_HMAC_SECRET=
# Set to "true" ONLY if Cloudflare sits in front of the origin AND direct origin access bypassing Cloudflare is blocked
# TRUST_CLOUDFLARE_PROXY=false

# Admin Authorization Defense-in-Depth (Stage 3B.3)
# Optional comma-separated list of normalized admin email addresses.
# When set, an account must BOTH have `role: "admin"` in MongoDB `users` AND appear in this allowlist.
# ADMIN_EMAIL_ALLOWLIST=

# Email Service Configuration (Resend)
# Used for account verification emails and password reset links.
RESEND_API_KEY=
EMAIL_FROM=LingoPDF <noreply@lingopdf.in>
EMAIL_REPLY_TO=support@lingopdf.in
# Set EMAIL_MOCK=true for local/CI automated testing when sender domain DNS verification is in progress
# EMAIL_MOCK=false
