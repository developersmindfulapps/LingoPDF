# LingoPDF Environment Variables Configuration
# Copy this file to .env.local for local development. Never commit .env.local to version control.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Chrome Web Store Configuration
# Centralized destination for "Get the Extension" CTAs. When empty/omitted, buttons show "Coming Soon".
# NEXT_PUBLIC_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/lingopdf-pdf-reader/<id>

# Database Configuration (MongoDB Atlas)
# Replace with your connection string from MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=lingo_pdf

# Email Service Configuration (Resend — Phase 6D-1)
# Used for account verification emails and password reset links.

EMAIL_FROM=LingoPDF <noreply@lingopdf.in>
EMAIL_REPLY_TO=support@lingopdf.in
# Set EMAIL_MOCK=true for local/CI automated testing when sender domain DNS verification is in progress
# EMAIL_MOCK=false

# Payment & Licensing (Planned for future phase - e.g. Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
